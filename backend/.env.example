# Japanese Study backend — contoh environment (AMAN di-push, tanpa secret).
# Cara pakai:
#   1. cp .env.example .env   (di folder backend/ atau /opt/japanese-study-v2/)
#   2. Isi setiap nilai dengan secret acak milikmu:
#        openssl rand -hex 32   (untuk JWT_SECRET / ADMIN_TOKEN)
#        openssl rand -hex 16   (untuk POSTGRES_PASSWORD / ADMIN_PASSWORD)
#   3. Jangan pernah commit file .env (sudah di-ignore).
#   4. Restart stack: docker compose up -d

# --- WAJIB ---
# Password database Postgres (dipakai db + DATABASE_URL api).
POSTGRES_PASSWORD=ganti-dengan-password-acak-min-16-karakter
# Secret JWT (TANPA ini server menolak start/fail-closed).
JWT_SECRET=ganti-dengan-jwt-secret-min-32-byte
# Token master untuk endpoint /api/admin/* (atau pakai JWT admin).
ADMIN_TOKEN=ganti-dengan-token-admin-acak
# Akun admin awal (dibuat otomatis oleh entrypoint via create-admin.js).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-password-admin-yang-kuat
ADMIN_NAME=Administrator

# --- OPSIONAL ---
# IP LAN untuk sertifikat TLS self-signed proxy (default di bawah).
TLS_IP=192.168.100.230
# Origin web yang dibolehkan (koma-dipisah). KOSONG = tolak semua (default
# aman; aplikasi mobile tidak butuh CORS). Contoh dev LAN:
# CORS_ORIGIN=https://192.168.100.230
CORS_ORIGIN=
# Project ID Firebase untuk cek `aud` token Google (kosong = tidak dicek).
FIREBASE_PROJECT_ID=
# Kunci enkripsi pengaturan secret di Postgres (32 byte hex).
# Buat dengan: openssl rand -hex 32
CONFIG_KEK=
# Email reset password via Gmail SMTP (App Password, bukan password akun).
# Cara: Google Account > Security > 2-Step Verification > App passwords.
# Kosong = mode log-only (server tetap jalan, forgot tetap 200 generik).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Nama pengirim di email + lama kode reset (menit, 5-60).
APP_NAME=Japanese Study
RESET_CODE_TTL_MIN=15
# Masa berlaku JWT (default server 7d bila kosong; mis. 7d, 12h).
JWT_EXPIRES_IN=7d
# Port publik web (legacy), default 8080.
WEB_PORT=8080
# Rate limit (opsional): auth per 15 mnt, api per menit.
AUTH_RATE_MAX=20
API_RATE_MAX=240

rules_version = '2';

// Production-oriented rules for the offline-first learning sync document.
// The client only owns /users/{uid}/progress/main; all other paths stay denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validProgressEnvelope() {
      return request.resource.data.keys().hasOnly([
        'data', 'fieldUpdatedAt', 'updatedAt'
      ])
      && request.resource.data.data is map
      && request.resource.data.fieldUpdatedAt is map
      && request.resource.data.updatedAt is timestamp
      && request.resource.data.data.size() <= 500
      && request.resource.data.fieldUpdatedAt.size() <= 500;
    }

    match /users/{userId}/progress/main {
      allow read: if owner(userId);
      allow create, update: if owner(userId) && validProgressEnvelope();
      allow delete: if owner(userId);
    }

    // No profile or arbitrary user-document writes from the client.
    // Backend-managed data, if needed, should use Admin SDK / IAM.
  }
}
